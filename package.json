{
	"name": "@typetorch/dev-server",
	"version": "0.1.0",
	"description": "TypeTorch remote-claude: lets allowlisted devs prompt Claude Code on your machine from inside a live Roblox dev server, behind a Cloudflare Quick Tunnel with JWT auth.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/typetorch/dev-server"
	},
	"keywords": ["roblox", "roblox-ts", "typetorch", "claude", "claude-code", "dev-server", "cloudflare-tunnel"],
	"type": "module",
	"bin": {
		"typetorch-dev-server": "src/index.ts"
	},
	"exports": {
		".": "./src/lib.ts"
	},
	"files": ["src", "README.md", "LICENSE"],
	"engines": {
		"bun": ">=1.3.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "bun src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"jose": "^6.2.12"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
