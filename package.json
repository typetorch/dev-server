{
	"name": "@typetorch/dev-server",
	"version": "0.2.0",
	"description": "TypeTorch remote-claude: lets allowlisted devs prompt Claude Code on your machine from inside a live Roblox dev server, behind a Cloudflare Quick Tunnel with JWT auth.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/typetorch/dev-server.git"
	},
	"homepage": "https://github.com/typetorch/dev-server#readme",
	"bugs": {
		"url": "https://github.com/typetorch/dev-server/issues"
	},
	"keywords": ["roblox", "roblox-ts", "typetorch", "claude", "claude-code", "dev-server", "cloudflare-tunnel"],
	"type": "module",
	"bin": {
		"typetorch-dev-server": "dist/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/lib.d.ts",
			"default": "./dist/lib.js"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "bun src/index.ts",
		"build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
		"test": "bun test",
		"test:node-http": "TT_TEST_HTTP_BACKEND=node TT_SKIP_TUNNEL=1 bun test",
		"smoke": "node scripts/smoke.mjs",
		"smoke:pack": "node scripts/smoke.mjs --pack",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build && bun test && node scripts/smoke.mjs --pack"
	},
	"dependencies": {
		"jose": "^6.2.12"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
